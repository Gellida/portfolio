# Environment variables for portfolio deployment

# Required: API endpoint for OcularIA diagnostic service
# Must use HTTPS and be properly configured during build/deploy
VITE_OCULARIA_API_BASE_URL=https://marco-explain-compiled-leonard.trycloudflare.com/

# Optional: Maximum number of OcularIA submissions (default: 25)
VITE_OCULARIA_MAX_SUBMISSIONS=25

# Optional: Site URL for SEO and canonical tags (defaults to current origin)
VITE_SITE_URL=https://josegellida.com

# Build configuration
VITE_BASE_URL=/
